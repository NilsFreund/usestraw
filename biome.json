{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "Use Uint8Array so the core runs everywhere.",
                  "process": "The core is sans-I/O and must not touch the process.",
                  "setTimeout": "Report deadlines through nextDeadline() instead.",
                  "setInterval": "Report deadlines through nextDeadline() instead.",
                  "setImmediate": "Report deadlines through nextDeadline() instead.",
                  "queueMicrotask": "The core must stay synchronous.",
                  "Date": "Take the time from the now argument.",
                  "performance": "Take the time from the now argument.",
                  "crypto": "Take randomness from the injected Random."
                }
              }
            }
          },
          "suspicious": {
            "noConsole": "error"
          }
        }
      }
    },
    {
      "includes": ["src/phone/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "Use Uint8Array so the phone runs in browsers too.",
                  "process": "The phone runs in browsers too: take what it needs from the platform."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/node/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**", "!src/node/**", "!src/index.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/node/*", "**/node"],
                    "message": "Only src/node and the entry files may import the Node platform."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/core/**",
        "src/message/**",
        "src/transaction/**",
        "src/transport/**",
        "src/auth/**",
        "src/sdp/**",
        "src/rtp/**",
        "src/support/**",
        "src/recorder/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/node/*", "**/node"],
                    "message": "The protocol layers stay below src/phone and src/node."
                  },
                  {
                    "group": ["**/phone/*", "**/phone"],
                    "message": "The protocol layers stay below src/phone and src/node."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
