{
  "name": "usestraw",
  "version": "0.0.0",
  "description": "SIP without the hangover: make and take phone calls from Node, with the audio as Web Streams. For voice apps and AI agents.",
  "keywords": [
    "sip",
    "voip",
    "telephony",
    "phone",
    "softphone",
    "rtp",
    "g711",
    "voice-ai",
    "voice-agent",
    "ai-agents",
    "asterisk",
    "freeswitch",
    "typescript"
  ],
  "homepage": "https://github.com/NilsFreund/usestraw#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NilsFreund/usestraw.git"
  },
  "bugs": {
    "url": "https://github.com/NilsFreund/usestraw/issues"
  },
  "license": "MIT",
  "author": "Nils Freund",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc && tsc -p tsconfig.neutral.json && tsc -p examples",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "biome check && bun run typecheck && vitest run --coverage",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "lefthook": "^2.2.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  }
}
