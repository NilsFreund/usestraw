{
  "name": "usestraw",
  "version": "0.0.0",
  "description": "SIP without the hangover. A modern TypeScript SIP stack for voice apps and AI agents (WebRTC, VoIP).",
  "keywords": [
    "sip",
    "voip",
    "webrtc",
    "telephony",
    "softphone",
    "typescript",
    "voice-ai",
    "ai-agents",
    "asterisk",
    "freeswitch"
  ],
  "homepage": "https://usestraw.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NilsFreund/usestraw.git"
  },
  "license": "MIT",
  "author": "Nils Freund",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "biome check && tsc && vitest run --passWithNoTests",
    "prepublishOnly": "bun run check && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "lefthook": "^2.2.1",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  }
}
